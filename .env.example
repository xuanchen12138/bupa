# Copy to .env in the project root. The API key is read by the backend only.
HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
# Business providers, cover and appointments remain fictional.
DEMO_MODE=true
MODEL_MODE=scripted
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_CHARS=60000
DATABASE_PATH=.data/bupa.sqlite
HISTORY_SEED=true
# mock = independent browser demo; http = local API through Vite proxy.
VITE_API_MODE=mock
# Set MODEL_MODE=openai with a key for real replies and health extraction.
# Personalization stays off until the member explicitly enables it.
# History/overview HTTP capability switches in apps/web are maintained by FE.
