# Optional: copy this file to .env in the repository root.
# The offline backend starts with these defaults without a database or an API key.
HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
DEMO_MODE=true
# Only true is implemented. false is rejected; it does not enable a real model.
# Frontend data source: mock (in-browser demo service, default) or http (apps/api over /api).
VITE_API_MODE=mock
# Phase-one history/personalization uses browser mock storage managed by the frontend.
# HTTP currently supports the existing booking/chat APIs, not history/health-overview.
# Database/model configuration and migrations will be added in phase two.
